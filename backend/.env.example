# TrackROI Backend - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores.

# Porta HTTP do backend
PORT=4100

# Credenciais do usuário administrador (criado automaticamente no primeiro uso)
ADMIN_EMAIL=admin@trackroi.local
ADMIN_PASSWORD=TrackROI!2026

# Permite o cadastro de novos usuários pela tela de login (false = apenas login)
# ALLOW_REGISTRATION=true

# Origem do backend (usada no redirect OAuth da Meta)
# Em produção, use a URL pública: https://seu-dominio.com
BACKEND_ORIGIN=http://localhost:4100

# Origens permitidas para CORS (separadas por vírgula)
# Ex.: http://localhost:5180,https://app.seudominio.com
ALLOWED_ORIGINS=http://localhost:5180

# Origem do frontend (usada para redirecionar após OAuth)
FRONTEND_ORIGIN=http://localhost:5180

# --- Integração Meta Ads (OAuth2) ---
# Crie um app em https://developers.facebook.com
META_API_VERSION=v22.0
META_APP_ID=
META_APP_SECRET=
# Deixe vazio para usar: {BACKEND_ORIGIN}/api/integrations/connect/meta/callback
# META_REDIRECT_URI=
META_SCOPES=ads_read,ads_management,pages_read_engagement,pages_show_list

# --- Integração Perfect Pay ---
# Definir no painel da Perfect Pay o webhook com header:
#   x-perfectpay-signature: <HMAC-SHA256 do body>
# O segredo é armazenado no state.json via configuração manual.
# PERFECTPAY_API_BASE=https://app.perfectpay.com.br

# --- Criptografia dos tokens armazenados (opcional, recomendado) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Se vazio, tokens são salvos em texto plano (não recomendado para produção).
ENCRYPTION_KEY=

# --- HTTPS (opcional) ---
# Ative apenas se fornecer certificados em backend/certs/cert.pem e key.pem
# ENABLE_TLS=true
# TLS_CERT=
# TLS_KEY=